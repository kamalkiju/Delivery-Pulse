PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/deliverypulse?appName=deliverypulse
JWT_SECRET=your_long_random_secret_here_minimum_32_characters
JWT_EXPIRES_IN=7d
CLAUDE_API_KEY=sk-ant-your-key-here
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_APP_TOKEN=xapp-your-app-level-token
# Slack OAuth (api.slack.com → OAuth & Permissions)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
# Must match Slack app redirect URLs exactly
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
ADO_ORG=your_ado_organisation_name
ADO_PROJECT=your_ado_project_name
ADO_TOKEN=your_ado_personal_access_token
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
